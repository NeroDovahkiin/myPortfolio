---
import { Icon } from "astro-icon/components";
import type { CompatibilityItem } from "~/types";

export interface Props {
  items: Array<CompatibilityItem>;
  title: string;
  url: string;
  cols?: number;
}

const { items, title, url, cols } = Astro.props;

const colsClass: Record<number, string> = {
  8: "sm:grid-cols-4 md:grid-cols-8",
  9: "sm:grid-cols-5 md:grid-cols-9",
};
const gridCols = colsClass[cols ?? items.length] ?? "sm:grid-cols-4 md:grid-cols-8";
---

<div class="w-full max-w-7xl space-y-2">
  <div class="relative border border-default bg-offset px-6 pb-4 pt-8">
    <h3
      class="absolute right-4 top-0 -translate-y-1/2 rounded-full border border-current bg-default px-4 py-1 uppercase tracking-tight text-xs"
    >
      {title}
    </h3>
    <ul class={`grid grid-cols-2 gap-6 ${gridCols}`}>
      {
        items.map((item) => (
          <li>
            <a class="flex flex-col items-center gap-2" href={item.url}>
              <Icon class="size-10" name={item.icon} />
              <span class="text-xs text-center">{item.title}</span>
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</div>
