---
import { Icon } from "astro-icon/components";
import ThemeSwitcher from "~/components/theme-switcher.astro";
import type { NavItem } from "~/types";

const navItems: Array<NavItem> = [
  { title: "Timeline", url: "#features" },
  { title: "Conocimientos", url: "#conocimientos" },
  { title: "Proyectos", url: "#proyectos" },
  { title: "Contacto", url: "#contacto" },
];
---

<header
  id="page-header"
  class="absolute bottom-0 z-20 flex w-full items-center justify-between border-b border-transparent px-8 py-4 text-white"
>
  <a class="flex items-center gap-3 hover:!text-default" href="/">
    <h1 class="sr-only">fGuzzoDev</h1>
    <Icon name="logomark" class="size-10" />
    <Icon name="wordmark" class="hidden h-5 sm:block" />
  </a>
  <div>
    <div class="flex items-center gap-6">
      <nav class="hidden sm:block">
        <ul class="flex items-center gap-6">
          {
            navItems.map(({ title, url }) => (
              <li>
                <a class="text-sm" href={url}>
                  {title}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>
      <button
        id="open-nav-button"
        type="button"
        class="btn sm:hidden"
        aria-label="Navigation"
      >
        <Icon name="mdi:menu" class="size-8" />
      </button>
      <ThemeSwitcher />
    </div>
    <div id="menu-modal" class="modal hidden" aria-hidden="true">
      <div class="fixed inset-0 bg-default px-8 py-4 text-default">
        <div class="space-y-4" role="dialog" aria-modal="true">
          <header class="text-right">
            <button
              id="close-nav-button"
              type="button"
              class="btn"
              aria-label="Close navigation"
            >
              <Icon name="mdi:close" class="size-8" />
            </button>
          </header>
          <div class="flex justify-center">
            <Icon name="logomark" class="size-16" />
          </div>
          <nav>
            <ul class="flex flex-col">
              {
                navItems.map(({ title, url }) => (
                  <li>
                    <a class="block py-4 text-center text-xl" href={url}>
                      {title}
                    </a>
                  </li>
                ))
              }
            </ul>
          </nav>
        </div>
      </div>
    </div>
  </div>
</header>

<script>
  import MicroModal from "micromodal";
  import invariant from "tiny-invariant";

  const menuModalId = "menu-modal";

  const header = document.querySelector("#page-header") as HTMLElement;
  const page = document.documentElement;
  const heroScroll = document.querySelector("#heroScroll") as HTMLElement | null;
  const menu = document.querySelector(`#${menuModalId} ul`);
  const openNavButton = document.querySelector("#open-nav-button");
  const closeNavButton = document.querySelector("#close-nav-button");

  invariant(header, "header should not be null");
  invariant(menu, "menu should not be null");
  invariant(openNavButton, "openNavButton should not be null");
  invariant(closeNavButton, "closeNavButton should not be null");

  const openMenu = () => {
    MicroModal.show(menuModalId, { disableScroll: true });
  };

  const closeMenu = () => {
    MicroModal.close(menuModalId);
  };

  openNavButton.addEventListener("click", openMenu);
  closeNavButton.addEventListener("click", closeMenu);

  // The hero itself doesn't visually move while its scroll-driven frames are
  // scrubbing (it's pinned via `position: sticky`) — it only starts actually
  // sliding up once that scrubbing finishes. The nav mirrors that: it stays
  // put at the bottom of the hero for the whole scrubbing phase, then rides
  // up glued to the hero 1:1 as it scrolls away (same px-per-px rate as the
  // hero's own motion, not a distance divided over an arbitrary range), so
  // it docks at the top the instant it catches up instead of lagging behind.
  //
  // Layout metrics (offsetHeight, innerHeight) are cached and only
  // recomputed on resize — reading them inside the scroll handler itself
  // forces a synchronous layout on every scroll event (right after writing
  // the transform below), which is what showed up as a small stutter/bounce
  // during fast scrolling.
  let restOffset = 0;
  let heroRisesAt = 0;

  function recomputeHeroNavMetrics(heroEl: HTMLElement) {
    const viewportH = window.innerHeight;
    restOffset = Math.max(viewportH - header.offsetHeight, 0);
    heroRisesAt = Math.max(heroEl.offsetHeight - viewportH, 0);
  }

  function updateHeaderWithHero() {
    const risen = Math.max(page.scrollTop - heroRisesAt, 0);
    const offset = Math.max(restOffset - risen, 0);

    header.style.transform = `translateY(${offset}px)`;
    header.classList.toggle("fixed-header", offset <= 0);
  }

  if (heroScroll) {
    header.style.position = "fixed";
    header.style.top = "0";
    header.style.bottom = "auto";

    recomputeHeroNavMetrics(heroScroll);
    window.addEventListener("resize", () => recomputeHeroNavMetrics(heroScroll));

    // Driven by requestAnimationFrame instead of the "scroll" event: the
    // event only fires when the browser gets around to dispatching it,
    // which can trail a frame or more behind the actual (compositor-driven)
    // scroll position under load — enough to read as a slight lag/bounce
    // on an element with no smoothing of its own. Polling scrollTop right
    // before paint keeps it reading the freshest position every frame.
    (function loop() {
      updateHeaderWithHero();
      requestAnimationFrame(loop);
    })();
  } else {
    document.addEventListener("scroll", () => {
      const d = page.clientHeight - page.scrollTop - header.offsetHeight;
      header.classList.toggle("fixed-header", d < 0);
    });
  }

  menu.addEventListener("click", (event) => {
    if ((event.target as HTMLElement).tagName === "A") {
      closeMenu();
    }
  });

  // Smooth-scroll in-page nav links via JS instead of the global CSS
  // `scroll-behavior: smooth` — that property also applies to native wheel/
  // trackpad scrolling and fights with the hero's scroll-linked animation,
  // which is what caused the nav's bounce.
  document.addEventListener("click", (event) => {
    const link = (event.target as HTMLElement).closest('a[href^="#"]');
    const hash = link?.getAttribute("href");
    if (!hash || hash.length < 2) return;
    const target = document.querySelector(hash);
    if (!target) return;
    event.preventDefault();
    target.scrollIntoView({ behavior: "smooth", block: "start" });
  });
</script>

<noscript>
  <style>
    #open-nav-button {
      display: none;
    }
  </style>
</noscript>

<style>
  .fixed-header {
    @apply fixed bottom-auto top-0;
    @apply border-default bg-default text-default;
  }
  .modal.is-open {
    @apply block;
  }
</style>
