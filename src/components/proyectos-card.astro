---
import type { CollectionEntry } from "astro:content";

export interface Props {
  site: CollectionEntry<"showcase">;
}

const { site } = Astro.props;
const techs = site.data.technologies?.slice(0, 3) ?? [];
---

<a href={site.data.url} class="group block w-72 shrink-0 rounded-2xl overflow-hidden shadow-lg hover:shadow-2xl transition-all duration-300 hover:-translate-y-1 bg-gray-900 outline-none no-underline">
  <figure class="relative aspect-video overflow-hidden">
    <img
      class="block w-full h-full object-cover transition-transform duration-500 group-hover:scale-105"
      src={site.data.image}
      alt={`Captura de ${site.data.title}`}
      loading="lazy"
      decoding="async"
    />
    <!-- gradiente permanente en la parte de abajo -->
    <div class="absolute inset-0 bg-gradient-to-t from-gray-900 via-gray-900/20 to-transparent"></div>

    <!-- botón que aparece al hover -->
    <div class="absolute inset-0 flex items-center justify-center opacity-0 group-hover:opacity-100 transition-opacity duration-300">
      <span class="bg-white/10 backdrop-blur-sm border border-white/30 text-white text-sm font-semibold px-5 py-2 rounded-full">
        Ver proyecto →
      </span>
    </div>
  </figure>

  <div class="px-4 py-3">
    <h3 class="text-white font-bold text-base truncate">{site.data.title}</h3>
    {techs.length > 0 && (
      <div class="flex flex-wrap gap-1 mt-2">
        {techs.map((tech) => (
          <span class="text-xs bg-white/10 text-gray-300 px-2 py-0.5 rounded-full">{tech}</span>
        ))}
      </div>
    )}
  </div>
</a>
