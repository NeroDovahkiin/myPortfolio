---
---

<div class="launcher-overlay" id="launcherOverlay">
  <iframe
    id="launcherFrame"
    class="launcher-frame"
    data-src="/launcher.html"
    title="Cargando"
    allow="autoplay"
  ></iframe>
</div>

<script is:inline>
  (function () {
    var KEY = "launcherShown";
    var overlay = document.getElementById("launcherOverlay");
    if (!overlay) return;

    // A link opened in a new tab/window (right-click, ctrl/cmd-click, a
    // target="_blank" demo link, etc.) gets its own sessionStorage that
    // never saw the flag below, even though the visitor was already
    // browsing the site. Treat "arrived here from another page on this
    // same site" the same as "already shown" so the launcher doesn't
    // replay in that new tab.
    var cameFromSameSite = false;
    try {
      cameFromSameSite = !!document.referrer && new URL(document.referrer).origin === location.origin;
    } catch (e) {}

    if (sessionStorage.getItem(KEY) || cameFromSameSite) {
      // Not a fresh entry to the site — remove it outright, before it ever
      // paints. Crucially, the iframe never gets a src in this branch, so
      // launcher.html (and its audio) never loads at all.
      sessionStorage.setItem(KEY, "1");
      overlay.remove();
      return;
    }

    sessionStorage.setItem(KEY, "1");
    overlay.dataset.active = "true";
    var frame = document.getElementById("launcherFrame");
    if (frame) frame.src = frame.dataset.src;
  })();
</script>

<style>
  .launcher-overlay {
    position: fixed;
    inset: 0;
    z-index: 9999;
    background: #0b0d12;
    opacity: 1;
    transition: opacity 0.4s ease;
  }

  .launcher-overlay.is-hidden {
    opacity: 0;
    pointer-events: none;
  }

  .launcher-frame {
    width: 100%;
    height: 100%;
    border: none;
    display: block;
  }
</style>

<script>
  // Waits for two things before handing off to the site: (1) the terminal
  // animation inside the iframe actually finishing (it posts a message when
  // it does — its typing speed is randomized, so a fixed timer either cuts
  // it off or leaves an awkward pause), and (2) the page (images, hero
  // frames, etc.) finishing its own load. Whichever takes longer wins.
  const overlay = document.getElementById("launcherOverlay");
  const frame = document.getElementById("launcherFrame") as HTMLIFrameElement | null;
  if (overlay && frame && overlay.dataset.active === "true") {
    // Safety net: if the completion message is ever lost (e.g. an error
    // inside the iframe), don't leave the launcher stuck forever.
    const MAX_WAIT_MS = 9000;

    let pageLoaded = document.readyState === "complete";
    let animationDone = false;
    let finished = false;

    function hideOverlay() {
      if (finished) return;
      finished = true;
      overlay.classList.add("is-hidden");
      window.setTimeout(() => overlay.remove(), 450);
    }

    function maybeFinish() {
      if (pageLoaded && animationDone) hideOverlay();
    }

    if (!pageLoaded) {
      window.addEventListener(
        "load",
        () => {
          pageLoaded = true;
          maybeFinish();
        },
        { once: true },
      );
    }

    window.addEventListener("message", (event) => {
      if (
        event.source === frame.contentWindow &&
        event.data &&
        event.data.source === "fguzzo-launcher" &&
        event.data.type === "complete"
      ) {
        animationDone = true;
        maybeFinish();
      }
    });

    window.setTimeout(hideOverlay, MAX_WAIT_MS);

    maybeFinish();
  }
</script>
