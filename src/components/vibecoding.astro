---
import { getAllProjects } from "~/lib/blob-projects";
import ContentSection from "~/components/content-section.astro";

const allEntries = await getAllProjects();
const proyectos = allEntries
  .filter((e) => e.section === "vibecoding")
  .sort((a, b) => (a.featured ?? 99) - (b.featured ?? 99));
---

<ContentSection title="Vibecoding" id="vibecoding" display="display:none">
  <Fragment slot="lead">
    Proyectos creados con <span class="text-primary">IA</span> como
    copiloto principal
  </Fragment>

  {proyectos.length === 0 ? (
    <p class="text-gray-400 text-center text-sm">Próximamente...</p>
  ) : (
    <div class="flex flex-wrap justify-center gap-5">
      {proyectos.map((entry) => (
        <a
          href={entry.url}
          class="group block w-72 shrink-0 rounded-2xl overflow-hidden shadow-lg hover:shadow-2xl transition-all duration-300 hover:-translate-y-1 bg-gray-900 outline-none no-underline"
        >
          <figure class="relative h-64 overflow-hidden">
            <img
              class="block w-full h-full object-scale-down transition-transform duration-500 group-hover:scale-105"
              src={entry.image}
              alt={entry.title}
              loading="lazy"
              decoding="async"
            />
            <div class="absolute inset-0 bg-gradient-to-t from-gray-900 via-gray-900/20 to-transparent"></div>
            <div class="absolute inset-0 flex items-center justify-center opacity-0 group-hover:opacity-100 transition-opacity duration-300">
              <span class="bg-white/10 backdrop-blur-sm border border-white/30 text-white text-sm font-semibold px-5 py-2 rounded-full">
                Ver proyecto →
              </span>
            </div>
          </figure>
          <div class="px-4 py-3">
            <h3 class="text-white font-bold text-base">{entry.title}</h3>
            <p class="text-gray-400 text-sm mt-1 line-clamp-2">{entry.description?.[0] ?? ""}</p>
            {entry.technologies && entry.technologies.length > 0 && (
              <div class="flex flex-wrap gap-1 mt-2">
                {entry.technologies.slice(0, 3).map((tech) => (
                  <span class="text-xs bg-white/10 text-gray-300 px-2 py-0.5 rounded-full">{tech}</span>
                ))}
              </div>
            )}
          </div>
        </a>
      ))}
    </div>
  )}
</ContentSection>
