---
import { Icon } from "astro-icon/components";
import TypyingText from "~/components/textTyping.astro";
---

<section class="hero-scroll" id="heroScroll">
  <div class="hero-sticky" id="heroSticky">
    <canvas id="heroCanvas"></canvas>
    <div class="hero-vignette"></div>
    <div class="hero-fx-layer-local" id="heroFxLayerLocal" aria-hidden="true"></div>

    <div class="hero-copy">
      <div class="hero-copy__stage" id="heroCopyStage">
        <div class="hero-copy__primary" id="heroCopyPrimary">
          <h3 class="text-white text-3xl md:text-3xl xl:text-5xl">Bienvenid@!</h3>
          <h2 class="hero-copy__name text-white text-5xl sm:text-4xl md:text-5xl xl:text-7xl whitespace-nowrap">
            <span class="text-cyan-400">me llamo</span> Federico
          </h2>
          <div class="hero-copy__role text-3xl sm:text-4xl md:text-5xl xl:text-7xl">
            <TypyingText />
          </div>
        </div>
        <div class="hero-copy__alt" id="heroCopyAlt">
          <h2 class="hero-copy__alt-text text-white text-4xl sm:text-3xl md:text-4xl xl:text-6xl font-bold">
            Transformando tus ideas en <span class="text-cyan-400">soluciones</span>
          </h2>
        </div>
      </div>
      <div class="hero-copy__socials">
        <a href="https://codepen.io/NeroDovahkiin" class="social-icon" aria-label="codepen"><Icon name="mdi:codepen" class="size-10 text-white" /></a>
        <a href="https://www.linkedin.com/in/federicogmenezes/" class="social-icon" aria-label="linkedin"><Icon name="mdi:linkedin" class="size-10 text-white" /></a>
        <a href="https://www.instagram.com/nero_fgm/" class="social-icon" aria-label="instagram"><Icon name="mdi:instagram" class="size-10 text-white" /></a>
        <a href="https://github.com/NeroDovahkiin" class="social-icon" aria-label="github"><Icon name="mdi:github" class="size-10 text-white" /></a>
      </div>
    </div>

    <button type="button" class="hero-skip-btn" id="heroSkipBtn">
      Cancelar animación
    </button>

    <div class="scroll-hint" id="scrollHint" aria-hidden="true">
      <span>Scroll</span>
      <div class="scroll-hint__mouse"><div class="scroll-hint__dot"></div></div>
    </div>
  </div>
</section>

<div class="hero-fx-layer" id="heroFxLayer" aria-hidden="true"></div>
<div class="hero-cursor-tag" id="heroCursorTag" aria-hidden="true">{"{ }"}</div>

<style>
  .hero-scroll {
    position: relative;
    /* Scroll distance driving the frame sequence — scaled so the vh-per-frame
       ratio stays roughly constant if FRAME_COUNT below changes. */
    height: 500vh;
    background: #000;
  }

  /* Applied once the "Cancelar animación" button is used: collapses the
     500vh scroll-scrub zone back down to a normal, single-viewport hero so
     the rest of the page scrolls immediately below it instead of through
     the (now frozen) frame sequence. */
  .hero-scroll--static {
    height: 100vh;
  }

  .hero-sticky {
    position: sticky;
    top: 0;
    height: 100vh;
    overflow: hidden;
    background: #000 url("/hero-frames/001.webp") center / cover no-repeat;
  }

  /* Visible and clickable from first paint, always at this same spot —
     unlike .scroll-hint above it, its visibility isn't tied to scroll. */
  .hero-skip-btn {
    position: absolute;
    left: 50%;
    bottom: 36px;
    transform: translateX(-50%);
    z-index: 6;
    padding: 8px 16px;
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    white-space: nowrap;
    color: rgba(255, 255, 255, 0.85);
    background: rgba(255, 255, 255, 0.08);
    border: 1px solid rgba(255, 255, 255, 0.25);
    border-radius: 999px;
    backdrop-filter: blur(6px);
    cursor: pointer;
    transition: background 0.2s ease;
  }

  .hero-skip-btn:hover {
    background: rgba(255, 255, 255, 0.18);
  }

  #heroCanvas {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    display: block;
  }

  .hero-vignette {
    position: absolute;
    inset: 0;
    pointer-events: none;
    background: linear-gradient(
      to bottom,
      rgba(0, 0, 0, 0.65) 0%,
      rgba(0, 0, 0, 0.25) 30%,
      rgba(0, 0, 0, 0.25) 70%,
      rgba(0, 0, 0, 0.7) 100%
    );
  }

  .hero-copy {
    position: absolute;
    left: 5%;
    right: 5%;
    top: 50%;
    transform: translateY(-50%);
    max-width: 900px;
    text-align: left;
    z-index: 5;
    color: #fff;
  }

  /* Both children of the stage occupy the same grid cell, so they overlay
     each other exactly (the track sizes to the taller one) without either
     needing a hardcoded height. They never overlap visually, though: the
     scroll handler fully fades+slides the primary text out (opacity 0)
     before the alt text starts fading+sliding in, so there's a brief gap
     where neither is visible rather than a cross-dissolve. */
  .hero-copy__stage {
    display: grid;
  }

  .hero-copy__primary,
  .hero-copy__alt {
    grid-area: 1 / 1;
    will-change: transform, opacity;
  }

  .hero-copy__alt {
    opacity: 0;
  }

  .hero-copy h3 {
    margin: 0 0 4px;
    font-weight: 700;
  }

  .hero-copy__name {
    margin: 0 0 12px;
    font-weight: 700;
  }

  .hero-copy__role {
    font-weight: 700;
  }

  .hero-copy__socials {
    display: flex;
    gap: 12px;
    margin-top: 24px;
  }

  .social-icon {
    display: flex;
    align-items: center;
    justify-content: center;
    background-color: darkslategrey;
    padding: 5px;
    border-radius: 10px;
    transition: opacity 0.2s ease;
  }

  .social-icon:hover {
    opacity: 0.8;
  }

  .scroll-hint {
    position: absolute;
    left: 50%;
    bottom: 96px;
    transform: translateX(-50%);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 10px;
    color: rgba(255, 255, 255, 0.75);
    font-size: 11px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    z-index: 5;
    /* Purely decorative — fades out with scroll progress via JS. */
    pointer-events: none;
    transition: opacity 0.3s ease;
  }
  .scroll-hint__mouse {
    width: 22px;
    height: 34px;
    border: 1.5px solid rgba(255, 255, 255, 0.5);
    border-radius: 12px;
    position: relative;
  }
  .scroll-hint__dot {
    position: absolute;
    top: 6px;
    left: 50%;
    width: 3px;
    height: 6px;
    background: #fff;
    border-radius: 2px;
    transform: translateX(-50%);
    animation: scrollDot 1.6s ease-in-out infinite;
  }
  @keyframes scrollDot {
    0% {
      opacity: 1;
      top: 6px;
    }
    60% {
      opacity: 0;
      top: 16px;
    }
    100% {
      opacity: 0;
      top: 6px;
    }
  }

  @media (max-width: 720px) {
    .hero-copy {
      left: 6%;
      right: 6%;
      max-width: none;
    }
  }

  .hero-fx-layer {
    position: fixed;
    inset: 0;
    overflow: hidden;
    pointer-events: none;
    /* Negative so it paints behind normal page content (text, images) —
       CSS stacking order puts negative z-index below in-flow content but
       still above the page's own background. */
    z-index: -1;
  }

  /* Mirrors .hero-fx-layer, but lives inside .hero-sticky (between the
     canvas/vignette and .hero-copy in DOM order) so it can sit above the
     hero's own background image while staying below the hero text. A
     fixed-position layer outside the hero can't do that: .hero-sticky
     forms its own stacking context, so an external sibling is either
     entirely above or entirely below the whole thing, never threaded
     between its background and its text. */
  .hero-fx-layer-local {
    position: absolute;
    inset: 0;
    overflow: hidden;
    pointer-events: none;
  }

  .hero-cursor-tag {
    position: fixed;
    top: 0;
    left: 0;
    transform: translate3d(-9999px, -9999px, 0);
    pointer-events: none;
    z-index: 46;
    font-family: "Fira Code", ui-monospace, monospace;
    font-size: 13px;
    font-weight: 600;
    color: #fff;
    opacity: 0;
    transition: opacity 0.2s ease;
    will-change: transform, opacity;
  }

  /* Desktop-only effect: hide on touch/coarse-pointer devices so it never
     flashes or gets stuck visible from a mouse-emulated touch event. */
  @media (hover: none), (pointer: coarse) {
    .hero-fx-layer,
    .hero-fx-layer-local,
    .hero-cursor-tag {
      display: none;
    }
  }
</style>

<style is:global>
  /* These spans are created at runtime via document.createElement, so they
     never receive Astro's scoped-style attribute — the rules for them have
     to live in a global block or they'd silently no-op (position: static). */
  .hero-fx-snippet {
    position: absolute;
    transform: translate(-50%, -50%);
    font-family: "Fira Code", "JetBrains Mono", ui-monospace, monospace;
    font-size: 12px;
    color: #67e8f9;
    text-shadow: 0 0 8px rgba(103, 232, 249, 0.55);
    opacity: 0.9;
    white-space: nowrap;
    pointer-events: none;
    transition: transform 1.2s ease-out, opacity 1.2s ease-out;
    will-change: transform, opacity;
  }

  .hero-fx-snippet--float {
    opacity: 0;
    transform: translate(-50%, -220%);
  }
</style>

<script>
  const FRAME_COUNT = 101;
  const FRAME_PATH = (i: number) => `/hero-frames/${String(i).padStart(3, "0")}.webp`;

  const canvas = document.getElementById("heroCanvas") as HTMLCanvasElement;
  const ctx = canvas.getContext("2d")!;
  const heroScroll = document.getElementById("heroScroll")!;
  const scrollHint = document.getElementById("scrollHint")!;
  const heroCopyStage = document.getElementById("heroCopyStage")!;
  const heroCopyPrimary = document.getElementById("heroCopyPrimary")!;
  const heroCopyAlt = document.getElementById("heroCopyAlt")!;
  const heroSkipBtn = document.getElementById("heroSkipBtn")!;

  const prefersReducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

  const images: HTMLImageElement[] = new Array(FRAME_COUNT);

  let dpr = Math.min(window.devicePixelRatio || 1, 2);
  let canvasW = 0;
  let canvasH = 0;

  let targetFrame = 0; // frame implied by current scroll position
  let renderedFrame = -1; // last frame index actually drawn
  let smoothFrame = 0; // frame actually rendered, spring-driven toward targetFrame
  let frameVelocity = 0; // current speed of smoothFrame, in frames/second
  let lastTick = 0;
  let rafId = 0; // id of the in-flight tick() rAF, so it can be cancelled

  // Damped-spring constants: smoothFrame chases targetFrame instead of
  // jumping to it. Damping is deliberately a bit below the critical point
  // for SPRING_STIFFNESS, so residual velocity carries the sequence a few
  // extra frames past where you stopped scrolling before it settles back —
  // that trailing coast is what reads as "inertia".
  const SPRING_STIFFNESS = 16;
  const SPRING_DAMPING = 6;

  // Hard cap on playback speed (frames/second), applied on top of the
  // spring. No matter how large a jump the scroll implies, frameVelocity
  // can't exceed this — it just falls behind and coasts back in afterward,
  // instead of the spring accelerating to an ever-larger speed.
  const MAX_FRAME_VELOCITY = 28;

  // 1 = original frames, lower = darker.
  const FRAME_BRIGHTNESS = 0.6;

  function clamp01(v: number) {
    return Math.max(0, Math.min(1, v));
  }

  function clampIndex(i: number) {
    return Math.max(0, Math.min(FRAME_COUNT - 1, i));
  }

  function resizeCanvas() {
    dpr = Math.min(window.devicePixelRatio || 1, 2);
    canvasW = canvas.clientWidth;
    canvasH = canvas.clientHeight;
    canvas.width = Math.round(canvasW * dpr);
    canvas.height = Math.round(canvasH * dpr);
    ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
    renderedFrame = -1; // force redraw at new size
  }

  function drawFrame(index: number) {
    const img = images[index];
    if (!img || !img.complete || img.naturalWidth === 0) return;

    const imgRatio = img.naturalWidth / img.naturalHeight;
    const canRatio = canvasW / canvasH;

    let drawW, drawH, offX, offY;
    if (imgRatio > canRatio) {
      drawH = canvasH;
      drawW = drawH * imgRatio;
      offX = (canvasW - drawW) / 2;
      offY = 0;
    } else {
      drawW = canvasW;
      drawH = drawW / imgRatio;
      offX = 0;
      offY = (canvasH - drawH) / 2;
    }

    ctx.clearRect(0, 0, canvasW, canvasH);
    ctx.filter = `brightness(${FRAME_BRIGHTNESS})`;
    ctx.drawImage(img, offX, offY, drawW, drawH);
    renderedFrame = index;
  }

  // Cached instead of recomputed inside onScroll: reading layout metrics
  // (offsetHeight/innerHeight) on every scroll event forces a synchronous
  // layout right after the canvas draw's style changes, which shows up as
  // stutter during fast scrolling. Only resize needs a fresh measurement.
  let scrollDistance = 1;

  function recomputeScrollDistance() {
    scrollDistance = Math.max(heroScroll.offsetHeight - window.innerHeight, 1);
  }

  // The primary copy (3 lines) and the alt line (2 lines) sit in the same
  // grid cell, so the stage's own height defaults to whichever is taller —
  // that leaves a gap between the shorter alt text and the socials row
  // below it. Animating the stage's height alongside the swap keeps the
  // socials hugging whichever text is actually showing.
  let heroCopyPrimaryHeight = 0;
  let heroCopyAltHeight = 0;

  function recomputeHeroCopyHeights() {
    heroCopyPrimaryHeight = heroCopyPrimary.scrollHeight;
    heroCopyAltHeight = heroCopyAlt.scrollHeight;
  }

  // Fraction of the hero's total scroll distance over which the "Scroll"
  // hint fades out. Larger = it stays visible longer before disappearing.
  const SCROLL_HINT_FADE_DISTANCE = 0.6;

  // The intro copy (name/role) swaps for the alt line at the midpoint of
  // the hero's scroll, over a small window centered on it. The two halves
  // of that window are sequential, not simultaneous: the primary text
  // fully fades+slides out first, then the alt text fades+slides in — so
  // there's a brief gap with neither visible instead of the two overlapping.
  const TEXT_SWAP_CENTER = 0.5;
  const TEXT_SWAP_RANGE = 0.3;
  const TEXT_SWAP_TRAVEL_PX = 28;

  function onScroll() {
    const progress = clamp01(window.scrollY / scrollDistance);

    targetFrame = progress * (FRAME_COUNT - 1);
    scrollHint.style.opacity = String(1 - clamp01(progress / SCROLL_HINT_FADE_DISTANCE));

    const swapT = clamp01((progress - (TEXT_SWAP_CENTER - TEXT_SWAP_RANGE / 2)) / TEXT_SWAP_RANGE);
    const outT = clamp01(swapT * 2); // 0 -> 1 over the first half: primary exits
    const inT = clamp01((swapT - 0.5) * 2); // 0 -> 1 over the second half: alt enters

    heroCopyPrimary.style.opacity = String(1 - outT);
    heroCopyPrimary.style.transform = `translateY(${outT * -TEXT_SWAP_TRAVEL_PX}px)`;

    heroCopyAlt.style.opacity = String(inT);
    heroCopyAlt.style.transform = `translateY(${(1 - inT) * TEXT_SWAP_TRAVEL_PX}px)`;

    heroCopyStage.style.height = `${heroCopyPrimaryHeight + (heroCopyAltHeight - heroCopyPrimaryHeight) * swapT}px`;
  }

  function tick(now: number) {
    const dt = lastTick ? Math.min((now - lastTick) / 1000, 0.045) : 0;
    lastTick = now;

    if (prefersReducedMotion) {
      smoothFrame = targetFrame;
      frameVelocity = 0;
    } else if (dt > 0) {
      const accel = (targetFrame - smoothFrame) * SPRING_STIFFNESS - frameVelocity * SPRING_DAMPING;
      frameVelocity += accel * dt;
      frameVelocity = Math.max(-MAX_FRAME_VELOCITY, Math.min(MAX_FRAME_VELOCITY, frameVelocity));
      smoothFrame += frameVelocity * dt;

      if (Math.abs(targetFrame - smoothFrame) < 0.02 && Math.abs(frameVelocity) < 0.02) {
        smoothFrame = targetFrame;
        frameVelocity = 0;
      }
    }

    const index = clampIndex(Math.round(smoothFrame));
    if (index !== renderedFrame) drawFrame(index);

    rafId = requestAnimationFrame(tick);
  }

  function preload() {
    for (let i = 1; i <= FRAME_COUNT; i++) {
      const img = new Image();
      img.decoding = "async";
      img.src = FRAME_PATH(i);
      images[i - 1] = img;
    }
    images[0].addEventListener("load", () => drawFrame(0), { once: true });
  }

  resizeCanvas();
  recomputeScrollDistance();
  recomputeHeroCopyHeights();
  preload();
  window.addEventListener("scroll", onScroll, { passive: true });
  window.addEventListener("resize", () => {
    resizeCanvas();
    recomputeScrollDistance();
    recomputeHeroCopyHeights();
    drawFrame(Math.round(smoothFrame));
  });

  // Snap straight to the first frame (e.g. for a "back to top" jump)
  // instead of letting the spring ease back through the whole sequence.
  window.addEventListener("hero:jump-to-start", () => {
    targetFrame = 0;
    smoothFrame = 0;
    frameVelocity = 0;
    drawFrame(0);
  });

  // "Cancelar animación" / "Habilitar animación": a toggle. Cancelling stops
  // the scroll-driven frame sequence for good and collapses the hero back
  // into a normal 100vh section, so the page reads as a static hero
  // followed by regular scrolling — no more 500vh scrub zone to animate
  // through. Re-enabling puts everything back exactly as it was on a fresh
  // page load (frame 0, scrolled to top) rather than trying to resume from
  // wherever the frame sequence was cut off — simpler, and scrolling back
  // down to where you were plays the same sequence anyway.
  let animationDisabled = false;

  function setAnimationDisabled(disabled: boolean) {
    animationDisabled = disabled;

    targetFrame = 0;
    smoothFrame = 0;
    frameVelocity = 0;
    drawFrame(0);

    if (window.scrollY > 0) window.scrollTo(0, 0);

    if (disabled) {
      window.removeEventListener("scroll", onScroll);
      cancelAnimationFrame(rafId);

      heroCopyPrimary.style.opacity = "1";
      heroCopyPrimary.style.transform = "translateY(0)";
      heroCopyAlt.style.opacity = "0";
      heroCopyAlt.style.transform = `translateY(${TEXT_SWAP_TRAVEL_PX}px)`;
      heroCopyStage.style.height = "";

      scrollHint.style.opacity = "0";
      heroSkipBtn.textContent = "Habilitar animación";

      heroScroll.classList.add("hero-scroll--static");
    } else {
      heroScroll.classList.remove("hero-scroll--static");

      heroSkipBtn.textContent = "Cancelar animación";

      window.addEventListener("scroll", onScroll, { passive: true });
      rafId = requestAnimationFrame(tick);

      recomputeScrollDistance();
      // Restores the fresh-load state: hint fully visible.
      onScroll();
    }

    // The header derives its "pinned to the hero's bottom" offset from the
    // hero's scroll height on resize only — nudge it now that the hero's
    // real height just changed underneath it.
    window.dispatchEvent(new Event("resize"));
  }

  heroSkipBtn.addEventListener("click", () => setAnimationDisabled(!animationDisabled));

  onScroll();
  rafId = requestAnimationFrame(tick);

  // Desktop-only "code cursor" effect: a small "{ }" tag tracks the mouse
  // anywhere on the page, and code-like snippets spawn near it, float up
  // and fade out. Gated on a real mouse (not just a wide viewport) so
  // touch devices — including tablets wider than a typical desktop
  // breakpoint — never trigger it. The layer/tag are position: fixed, so
  // they render above the page regardless of scroll position.
  const fxLayer = document.getElementById("heroFxLayer")!;
  const fxLayerLocal = document.getElementById("heroFxLayerLocal")!;
  const cursorTag = document.getElementById("heroCursorTag")!;
  const heroStickyEl = document.getElementById("heroSticky")!;
  const isDesktopPointer = window.matchMedia("(hover: hover) and (pointer: fine)").matches;

  if (isDesktopPointer && !prefersReducedMotion) {
    const SNIPPETS = [
      "const x =",
      "npm run dev",
      "λ()",
      "() => {}",
      "git commit",
      "async/await",
      "return true;",
      "<div/>",
      "import React",
      "0x1F",
    ];
    const SNIPPET_THROTTLE_MS = 60;
    const SNIPPET_LIFETIME_MS = 800;
    // Hard cap on concurrently-visible snippets, independent of how fast the
    // mouse moves — without this, sweeping the mouse across the screen keeps
    // spawning them along the whole path and the "tail" gets very long.
    const MAX_ACTIVE_SNIPPETS = 6;
    let lastSnippetSpawn = 0;
    const activeSnippets: HTMLElement[] = [];

    function spawnSnippet(x: number, y: number) {
      // While the cursor is over the hero, spawn into its local layer
      // (sandwiched between the background and the hero text in DOM order)
      // instead of the page-wide fixed one, so it can sit above the hero's
      // background image without also sitting above the hero text.
      const heroRect = heroStickyEl.getBoundingClientRect();
      const withinHero =
        x >= heroRect.left && x <= heroRect.right && y >= heroRect.top && y <= heroRect.bottom;
      const targetLayer = withinHero ? fxLayerLocal : fxLayer;
      const localX = withinHero ? x - heroRect.left : x;
      const localY = withinHero ? y - heroRect.top : y;

      const el = document.createElement("span");
      el.className = "hero-fx-snippet";
      el.textContent = SNIPPETS[Math.floor(Math.random() * SNIPPETS.length)];
      el.style.left = `${localX + (Math.random() - 0.5) * 40}px`;
      el.style.top = `${localY}px`;
      targetLayer.appendChild(el);
      activeSnippets.push(el);

      if (activeSnippets.length > MAX_ACTIVE_SNIPPETS) {
        activeSnippets.shift()?.remove();
      }

      requestAnimationFrame(() => el.classList.add("hero-fx-snippet--float"));
      window.setTimeout(() => {
        el.remove();
        const index = activeSnippets.indexOf(el);
        if (index !== -1) activeSnippets.splice(index, 1);
      }, SNIPPET_LIFETIME_MS);
    }

    document.addEventListener("mousemove", (event) => {
      const x = event.clientX;
      const y = event.clientY;

      // Hovering anything the site itself renders with a pointer cursor
      // (buttons, links, clickable cards, ...) hides the whole effect
      // instantly, so it never sits on top of something clickable. It
      // reappears the moment the cursor moves off that element.
      const target = event.target as Element | null;
      const isOverClickable = !!target && getComputedStyle(target).cursor === "pointer";

      if (isOverClickable) {
        cursorTag.style.opacity = "0";
        for (const el of activeSnippets) el.remove();
        activeSnippets.length = 0;
        return;
      }

      cursorTag.style.transform = `translate3d(${x + 14}px, ${y + 14}px, 0)`;
      cursorTag.style.opacity = "1";

      const now = performance.now();
      if (now - lastSnippetSpawn < SNIPPET_THROTTLE_MS) return;
      lastSnippetSpawn = now;
      spawnSnippet(x, y);
    });

    document.addEventListener("mouseleave", () => {
      cursorTag.style.opacity = "0";
    });
  }
</script>
