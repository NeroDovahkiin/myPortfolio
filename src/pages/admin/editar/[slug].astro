---
export const prerender = false;
import { getProjectBySlug } from "~/lib/blob-projects";
import type { GalleryImage, Project } from "~/types";

const { slug } = Astro.params;
const safeslug = (slug ?? "").replace(/[^a-zA-Z0-9\-_]/g, "");

let project: Project | null = null;
let loadError: string | null = null;
try {
  project = await getProjectBySlug(safeslug);
} catch (e) {
  loadError = e instanceof Error ? e.message : String(e);
}
const notFound = !project;

const existingImages: GalleryImage[] = project?.images ?? [];
const existingThumb: string = project?.image ?? "";
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Editar — {safeslug} — Admin</title>
    <script src="https://cdn.tailwindcss.com"></script>
  </head>
  <body class="min-h-screen bg-gray-950 text-white">
    <nav class="border-b border-gray-800 bg-gray-900 px-6 py-3 flex items-center gap-4">
      <a href="/admin/dashboard" class="text-gray-400 hover:text-white text-sm transition-colors">← Volver</a>
      <span class="font-bold">Editar: <span class="text-indigo-300">{safeslug}</span></span>
    </nav>

    {loadError ? (
      <main class="max-w-2xl mx-auto px-6 py-12 text-center text-gray-400">
        No se pudo cargar el proyecto ({loadError}). Puede ser algo momentáneo de Vercel Blob —
        <a href={`/admin/editar/${safeslug}`} class="underline hover:text-gray-200">recargá la página</a> en unos segundos.
      </main>
    ) : notFound ? (
      <main class="max-w-2xl mx-auto px-6 py-12 text-center text-gray-400">
        Proyecto no encontrado: <code class="text-red-400">{safeslug}</code>
      </main>
    ) : (
      <main class="max-w-2xl mx-auto px-6 py-8">
        <form id="form" class="space-y-5">
          <input type="hidden" name="slug" value={safeslug} />

          <div class="grid grid-cols-2 gap-4">
            <div class="col-span-2">
              <label class="label">Título</label>
              <input name="title" type="text" required class="input" value={project!.title} />
            </div>
            <div>
              <label class="label">Sección</label>
              <select name="section" class="input">
                <option value="" selected={!project!.section}>— sin sección —</option>
                <option value="proyectos" selected={project!.section === "proyectos"}>Proyectos</option>
                <option value="conceptos" selected={project!.section === "conceptos"}>Prueba de conceptos</option>
                <option value="vibecoding" selected={project!.section === "vibecoding"}>Vibecoding</option>
              </select>
            </div>
            <div>
              <label class="label">Orden (featured)</label>
              <input name="featured" type="number" min="1" class="input" value={project!.featured ?? ""} />
            </div>
            <div>
              <label class="label">URL pública</label>
              <input name="url" type="text" class="input" value={project!.url ?? safeslug} />
            </div>
            <div class="flex items-end pb-1">
              <label class="flex items-center gap-2 cursor-pointer">
                <input name="specialPage" type="checkbox" class="w-4 h-4 accent-indigo-500" checked={project!.specialPage === true} />
                <span class="text-sm text-gray-300">Página especial</span>
              </label>
            </div>
          </div>

          <!-- Thumbnail upload -->
          <div>
            <label class="label">Imagen miniatura</label>
            <div class="flex gap-3 items-start">
              <div
                id="thumb-drop"
                class="relative flex-shrink-0 w-32 h-20 rounded-lg border-2 border-dashed border-gray-700 hover:border-indigo-500 transition-colors cursor-pointer flex items-center justify-center bg-gray-900 overflow-hidden"
                onclick="document.getElementById('thumb-file').click()"
              >
                {existingThumb ? (
                  <img id="thumb-preview" src={existingThumb} alt="" class="absolute inset-0 w-full h-full rounded-lg" style={{ objectFit: project!.imageFit ?? "cover" }} />
                ) : (
                  <img id="thumb-preview" src="" alt="" class="hidden absolute inset-0 w-full h-full rounded-lg" style={{ objectFit: project!.imageFit ?? "cover" }} />
                )}
                <div id="thumb-placeholder" class={`text-center p-2 ${existingThumb ? "hidden" : ""}`}>
                  <div class="text-2xl text-gray-600">+</div>
                  <div class="text-xs text-gray-600 mt-0.5">Subir</div>
                </div>
                <div id="thumb-spinner" class="hidden absolute inset-0 flex items-center justify-center bg-gray-900/80">
                  <div class="w-5 h-5 border-2 border-indigo-400 border-t-transparent rounded-full animate-spin"></div>
                </div>
              </div>
              <div class="flex-1">
                <label class="label">Adaptación de imagen</label>
                <select name="imageFit" id="thumb-fit" class="input">
                  <option value="cover" selected={!project!.imageFit || project!.imageFit === "cover"}>Cubrir (recorta para llenar el marco)</option>
                  <option value="contain" selected={project!.imageFit === "contain"}>Contener (se ve completa, puede dejar espacios)</option>
                  <option value="fill" selected={project!.imageFit === "fill"}>Rellenar (estira, puede deformar)</option>
                  <option value="none" selected={project!.imageFit === "none"}>Centrar (tamaño real, sin escalar)</option>
                  <option value="scale-down" selected={project!.imageFit === "scale-down"}>Reducir si no entra</option>
                </select>
                <p id="img-error" class="hidden text-xs text-red-400 mt-1">⚠ La imagen de portada es requerida</p>
              </div>
            </div>
            <input id="thumb-file" type="file" accept="image/*" class="hidden" />
            <input name="image" id="thumb-path" type="hidden" value={existingThumb} />
          </div>

          <div>
            <label class="label">Descripción (una línea = un párrafo)</label>
            <textarea name="description" rows="4" class="input resize-none">{(project!.description ?? []).join("\n")}</textarea>
          </div>

          <div>
            <label class="label">Tecnologías (separadas por coma)</label>
            <input name="technologies" type="text" class="input" value={(project!.technologies ?? []).join(", ")} />
          </div>

          <!-- Gallery upload -->
          <div>
            <label class="label">Imágenes galería</label>
            <p class="text-xs text-gray-500 mb-2">Arrastrá las miniaturas para cambiar el orden en que aparecen en la galería del proyecto.</p>
            <div id="gallery-drop" class="gallery-drop">
              <div id="gallery-placeholder" class="gallery-placeholder">
                Clic para agregar imágenes a la galería (podés seleccionar varias)
              </div>
              <div id="gallery-thumbs" class="gallery-thumbs" data-initial={JSON.stringify(existingImages)}></div>
            </div>
            <input id="gallery-file" type="file" accept="image/*" multiple class="hidden" />
            <input type="hidden" name="images" id="gallery-paths" />
          </div>

          <!-- Gallery preview -->
          <div>
            <label class="label">Vista previa del carrusel</label>
            <p class="text-xs text-gray-500 mb-2">Así se va a ver la galería en la página del proyecto.</p>
            <div id="gallery-preview">
              <div class="preview-carousel">
                <div class="preview-slides" id="previewSlides"></div>
                <button class="preview-arrow preview-arrow-prev" id="previewPrev" type="button" aria-label="Anterior">&#8592;</button>
                <button class="preview-arrow preview-arrow-next" id="previewNext" type="button" aria-label="Siguiente">&#8594;</button>
                <div class="preview-dots" id="previewDots"></div>
              </div>
            </div>
          </div>

          <div class="grid grid-cols-2 gap-4">
            <div>
              <label class="label">URL demo</label>
              <input name="demoUrl" type="text" class="input" value={project!.demoUrl ?? ""} />
            </div>
            <div>
              <label class="label">Texto botón demo</label>
              <input name="demoLabel" type="text" class="input" value={project!.demoLabel ?? ""} />
            </div>
          </div>

          <div id="msg" class="hidden rounded-lg px-4 py-3 text-sm"></div>

          <button type="submit" class="w-full bg-indigo-600 hover:bg-indigo-500 text-white font-semibold rounded-lg py-2.5 transition-colors">
            Guardar cambios
          </button>
        </form>
      </main>
    )}

    <style>
      .label { display: block; font-size: 0.8rem; color: #9ca3af; margin-bottom: 0.25rem; }
      .input { width: 100%; background: #1f2937; color: white; border: 1px solid #374151; border-radius: 0.5rem; padding: 0.5rem 0.75rem; font-size: 0.875rem; outline: none; }
      .input:focus { border-color: #6366f1; }
      select.input option { background: #1f2937; }
      @keyframes spin { to { transform: rotate(360deg); } }
      .animate-spin { animation: spin 0.7s linear infinite; }

      .gallery-drop { border: 2px dashed #374151; border-radius: 0.75rem; padding: 1rem; background: #111827; min-height: 6.5rem; transition: border-color 0.2s; }
      .gallery-drop:hover { border-color: #6366f1; }
      .gallery-placeholder { text-align: center; color: #4b5563; font-size: 0.875rem; padding: 0.5rem 0; cursor: pointer; }
      .gallery-placeholder.hidden { display: none; }
      .gallery-thumbs { display: flex; gap: 0.75rem; overflow-x: auto; padding-bottom: 0.25rem; }
    </style>

    <!--
      Gallery tiles, the fit <select>, and the carousel preview slides/dots
      are all built at runtime via document.createElement (see initGallery
      in admin-gallery-client.ts and renderPreview() below). Astro's scoped
      styles only ever reach elements present in this file's own template —
      anything created client-side never gets the scoping attribute, so
      those rules have to live here, unscoped, or they silently no-op.
    -->
    <style is:global>
      @keyframes gallery-spin { to { transform: rotate(360deg); } }

      .gallery-tile { position: relative; flex: 0 0 auto; width: 9rem; height: 6.5rem; border-radius: 0.75rem; overflow: hidden; background: #1f2937; cursor: grab; border: 1px solid #374151; }
      .gallery-tile:active { cursor: grabbing; }
      .gallery-tile.dragging { opacity: 0.35; }
      .gallery-tile img { width: 100%; height: 100%; object-fit: cover; pointer-events: none; }
      .gallery-handle { position: absolute; top: 0.25rem; left: 0.25rem; background: rgba(0,0,0,0.55); color: #fff; font-size: 0.65rem; line-height: 1; padding: 0.2rem 0.3rem; border-radius: 0.35rem; letter-spacing: -1px; pointer-events: none; }
      .gallery-remove { position: absolute; top: 0.25rem; right: 0.25rem; width: 1.35rem; height: 1.35rem; background: rgba(0,0,0,0.7); color: #fff; border-radius: 999px; font-size: 0.8rem; line-height: 1; display: flex; align-items: center; justify-content: center; border: none; cursor: pointer; }
      .gallery-fit-select { position: absolute; left: 0; right: 0; bottom: 0; width: 100%; border: none; background: rgba(0,0,0,0.72); color: #fff; font-size: 0.65rem; line-height: 1.4; padding: 0.15rem 0.3rem; cursor: pointer; appearance: none; -webkit-appearance: none; text-align: center; text-align-last: center; }
      .gallery-fit-select:focus { outline: 1px solid #818cf8; outline-offset: -1px; }
      .gallery-tile-loading { display: flex; align-items: center; justify-content: center; }
      .gallery-spinner { width: 1.25rem; height: 1.25rem; border: 2px solid #818cf8; border-top-color: transparent; border-radius: 999px; animation: gallery-spin 0.7s linear infinite; }

      .preview-carousel { position: relative; border-radius: 0.75rem; overflow: hidden; background: #0d0d1a; border: 1px solid #374151; }
      .preview-slides { display: flex; transition: transform 0.35s ease; }
      .preview-slide { flex: 0 0 100%; width: 100%; min-height: 220px; max-height: 320px; display: flex; align-items: center; justify-content: center; background: #0d0d1a; }
      .preview-slide img { display: block; width: 100%; height: 100%; max-height: 320px; }
      .preview-empty-msg { color: #6b7280; font-size: 0.85rem; padding: 2rem; text-align: center; }
      .preview-arrow { position: absolute; top: 50%; transform: translateY(-50%); background: rgba(0,0,0,0.55); border: 1px solid rgba(255,255,255,0.15); color: #fff; width: 2.25rem; height: 2.25rem; border-radius: 50%; font-size: 1rem; cursor: pointer; display: flex; align-items: center; justify-content: center; }
      .preview-arrow:hover { background: rgba(0,0,0,0.85); }
      .preview-arrow-prev { left: 0.6rem; }
      .preview-arrow-next { right: 0.6rem; }
      .preview-dots { position: absolute; bottom: 0.6rem; left: 50%; transform: translateX(-50%); display: flex; gap: 0.35rem; background: rgba(0,0,0,0.45); padding: 0.3rem 0.55rem; border-radius: 999px; }
      .preview-dot { width: 0.4rem; height: 0.4rem; border-radius: 50%; background: rgba(255,255,255,0.45); border: none; cursor: pointer; padding: 0; }
      .preview-dot.active { background: #fff; }
    </style>

    <script>
      import { initGallery } from "~/lib/admin-gallery-client";

      const form = document.getElementById("form") as HTMLFormElement | null;

      if (form) {
        const SLUG = (form.querySelector('input[name="slug"]') as HTMLInputElement).value;

        async function uploadFile(file: File, slug: string) {
          const fd = new FormData();
          fd.append("file", file);
          fd.append("slug", slug);
          const res = await fetch("/api/admin/upload", { method: "POST", body: fd });
          if (!res.ok) {
            const err = await res.json();
            throw new Error(err.error ?? "Error al subir");
          }
          return (await res.json()).path;
        }

        // Thumbnail
        document.getElementById("thumb-file")!.addEventListener("change", async (e) => {
          const file = (e.target as HTMLInputElement).files?.[0];
          if (!file) return;
          const spinner = document.getElementById("thumb-spinner")!;
          const preview = document.getElementById("thumb-preview") as HTMLImageElement;
          const placeholder = document.getElementById("thumb-placeholder")!;
          spinner.classList.remove("hidden");
          try {
            const path = await uploadFile(file, SLUG);
            (document.getElementById("thumb-path") as HTMLInputElement).value = path;
            preview.src = path;
            preview.classList.remove("hidden");
            placeholder.classList.add("hidden");
          } catch (err) {
            alert((err as Error).message);
          } finally {
            spinner.classList.add("hidden");
            (e.target as HTMLInputElement).value = "";
          }
        });

        document.getElementById("thumb-fit")!.addEventListener("change", (e) => {
          const preview = document.getElementById("thumb-preview") as HTMLImageElement;
          preview.style.objectFit = (e.target as HTMLSelectElement).value;
        });

        // Gallery carousel preview — mirrors the carousel markup/behavior
        // used on the actual project page ([slug].astro), driven live by
        // whatever's currently in the gallery editor (before saving).
        const previewSlides = document.getElementById("previewSlides")!;
        const previewDots = document.getElementById("previewDots")!;
        const previewCarousel = document.querySelector("#gallery-preview .preview-carousel")!;
        let previewIndex = 0;

        function goToPreviewSlide(n: number) {
          const total = previewSlides.querySelectorAll(".preview-slide").length;
          if (total === 0) return;
          previewIndex = (n + total) % total;
          (previewSlides as HTMLElement).style.transform = `translateX(-${previewIndex * 100}%)`;
          previewDots.querySelectorAll(".preview-dot").forEach((d, i) => d.classList.toggle("active", i === previewIndex));
        }

        function renderPreview(images: { src: string; fit?: string }[]) {
          // Keep looking at the same slide across a re-render (e.g. tweaking
          // a fit, adding another image) instead of jumping back to the
          // first photo — only fall back when that slide no longer exists.
          const previousIndex = previewIndex;
          previewSlides.innerHTML = "";
          previewDots.innerHTML = "";

          if (!images.length) {
            previewSlides.innerHTML = `<div class="preview-slide"><p class="preview-empty-msg">Sin imágenes en la galería</p></div>`;
            previewCarousel.querySelectorAll(".preview-arrow, .preview-dots").forEach((el) => ((el as HTMLElement).style.display = "none"));
            return;
          }

          images.forEach((img, i) => {
            const slide = document.createElement("div");
            slide.className = "preview-slide";
            slide.innerHTML = `<img src="${img.src}" alt="" style="object-fit: ${img.fit || "contain"};" />`;
            previewSlides.appendChild(slide);

            const dot = document.createElement("button");
            dot.type = "button";
            dot.className = "preview-dot" + (i === 0 ? " active" : "");
            dot.setAttribute("aria-label", `Imagen ${i + 1}`);
            dot.addEventListener("click", () => goToPreviewSlide(i));
            previewDots.appendChild(dot);
          });

          const showNav = images.length > 1;
          previewCarousel.querySelectorAll(".preview-arrow, .preview-dots").forEach((el) => ((el as HTMLElement).style.display = showNav ? "" : "none"));
          goToPreviewSlide(Math.min(previousIndex, images.length - 1));
        }

        document.getElementById("previewPrev")!.addEventListener("click", () => goToPreviewSlide(previewIndex - 1));
        document.getElementById("previewNext")!.addEventListener("click", () => goToPreviewSlide(previewIndex + 1));

        // Gallery (drag-and-drop reorder)
        const initialImages = JSON.parse(
          document.getElementById("gallery-thumbs")?.dataset.initial || "[]"
        );
        initGallery({
          dropId: "gallery-drop",
          fileInputId: "gallery-file",
          thumbsId: "gallery-thumbs",
          placeholderId: "gallery-placeholder",
          pathsInputId: "gallery-paths",
          getSlug: () => SLUG,
          initial: initialImages,
          onChange: renderPreview,
        });

        // Submit
        form.addEventListener("submit", async (e) => {
          e.preventDefault();
          const fd = new FormData(form);

          if (!fd.get("image")) {
            const err = document.getElementById("img-error")!;
            err.classList.remove("hidden");
            document.getElementById("thumb-drop")!.scrollIntoView({ behavior: "smooth", block: "center" });
            return;
          }
          document.getElementById("img-error")!.classList.add("hidden");

          const body = {
            slug: fd.get("slug"),
            title: fd.get("title"),
            url: fd.get("url") || fd.get("slug"),
            image: fd.get("image") || undefined,
            imageFit: fd.get("imageFit") && fd.get("imageFit") !== "cover" ? fd.get("imageFit") : undefined,
            section: fd.get("section") || undefined,
            featured: fd.get("featured") ? Number(fd.get("featured")) : undefined,
            description: fd.get("description") ? String(fd.get("description")).split("\n").filter(Boolean) : undefined,
            technologies: fd.get("technologies") ? String(fd.get("technologies")).split(",").map((t) => t.trim()).filter(Boolean) : undefined,
            images: fd.get("images") ? JSON.parse(String(fd.get("images"))) : undefined,
            demoUrl: fd.get("demoUrl") || undefined,
            demoLabel: fd.get("demoLabel") || undefined,
            specialPage: fd.get("specialPage") === "on" ? true : undefined,
          };

          const res = await fetch("/api/admin/proyectos", {
            method: "PUT",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify(body),
          });

          const msg = document.getElementById("msg")!;
          msg.classList.remove("hidden");
          if (res.ok) {
            msg.className = "rounded-lg px-4 py-3 text-sm bg-green-500/10 border border-green-500/30 text-green-400";
            msg.textContent = "✓ Guardado correctamente. Redirigiendo...";
            setTimeout(() => (location.href = "/admin/dashboard"), 1200);
          } else {
            const err = await res.json();
            msg.className = "rounded-lg px-4 py-3 text-sm bg-red-500/10 border border-red-500/30 text-red-400";
            msg.textContent = "Error: " + (err.error ?? "desconocido");
          }
        });
      }
    </script>
  </body>
</html>
