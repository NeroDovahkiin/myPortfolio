---
export const prerender = false;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Nuevo proyecto — Admin</title>
    <script src="https://cdn.tailwindcss.com"></script>
  </head>
  <body class="min-h-screen bg-gray-950 text-white">
    <nav class="border-b border-gray-800 bg-gray-900 px-6 py-3 flex items-center gap-4">
      <a href="/admin/dashboard" class="text-gray-400 hover:text-white text-sm transition-colors">← Volver</a>
      <span class="font-bold">Nuevo proyecto</span>
    </nav>

    <main class="max-w-2xl mx-auto px-6 py-8">
      <form id="form" class="space-y-5">

        <div class="grid grid-cols-2 gap-4">
          <div class="col-span-2">
            <label class="label">Título</label>
            <input name="title" type="text" required class="input" placeholder="CARUP DESPACHO" />
          </div>
          <div>
            <label class="label">Slug <span class="text-gray-500">(nombre del archivo y carpeta)</span></label>
            <input id="slug" name="slug" type="text" required class="input" placeholder="carup" />
            <p class="text-xs text-gray-500 mt-1">Sin espacios ni caracteres especiales</p>
          </div>
          <div>
            <label class="label">Sección</label>
            <select name="section" class="input">
              <option value="">— sin sección —</option>
              <option value="proyectos">Proyectos</option>
              <option value="conceptos">Prueba de conceptos</option>
              <option value="vibecoding">Vibecoding</option>
            </select>
          </div>
          <div>
            <label class="label">Orden (featured)</label>
            <input name="featured" type="number" min="1" class="input" placeholder="1, 2, 3…" />
          </div>
          <div class="flex items-end pb-1">
            <label class="flex items-center gap-2 cursor-pointer">
              <input name="specialPage" type="checkbox" class="w-4 h-4 accent-indigo-500" />
              <span class="text-sm text-gray-300">Página especial</span>
            </label>
          </div>
        </div>

        <!-- Thumbnail upload -->
        <div>
          <label class="label">Imagen miniatura</label>
          <div class="flex gap-3 items-start">
            <div
              id="thumb-drop"
              class="relative flex-shrink-0 w-32 h-20 rounded-lg border-2 border-dashed border-gray-700 hover:border-indigo-500 transition-colors cursor-pointer flex items-center justify-center bg-gray-900 overflow-hidden"
              onclick="document.getElementById('thumb-file').click()"
            >
              <img id="thumb-preview" src="" alt="" class="hidden absolute inset-0 w-full h-full object-cover rounded-lg" />
              <div id="thumb-placeholder" class="text-center p-2">
                <div class="text-2xl text-gray-600">+</div>
                <div class="text-xs text-gray-600 mt-0.5">Subir</div>
              </div>
              <div id="thumb-spinner" class="hidden absolute inset-0 flex items-center justify-center bg-gray-900/80">
                <div class="w-5 h-5 border-2 border-indigo-400 border-t-transparent rounded-full animate-spin"></div>
              </div>
            </div>
            <div class="flex-1">
              <input name="image" id="thumb-path" type="text" class="input" placeholder="/proyectos/slug/preview.webp" />
              <p class="text-xs text-gray-500 mt-1">O ingresá el path manualmente</p>
              <p id="img-error" class="hidden text-xs text-red-400 mt-1">⚠ La imagen de portada es requerida</p>
            </div>
          </div>
          <input id="thumb-file" type="file" accept="image/*" class="hidden" />
        </div>

        <div>
          <label class="label">Descripción <span class="text-gray-500">(una línea = un párrafo)</span></label>
          <textarea name="description" rows="4" class="input resize-none" placeholder="Primer párrafo..."></textarea>
        </div>

        <div>
          <label class="label">Tecnologías <span class="text-gray-500">(separadas por coma)</span></label>
          <input name="technologies" type="text" class="input" placeholder="React, Node, MySQL" />
        </div>

        <!-- Gallery upload -->
        <div>
          <label class="label">Imágenes galería</label>
          <div
            id="gallery-drop"
            class="border-2 border-dashed border-gray-700 hover:border-indigo-500 transition-colors rounded-xl p-4 cursor-pointer bg-gray-900 min-h-[80px]"
            onclick="document.getElementById('gallery-file').click()"
          >
            <div id="gallery-placeholder" class="text-center text-gray-600 text-sm py-2">
              Clic para agregar imágenes a la galería (podés seleccionar varias)
            </div>
            <div id="gallery-thumbs" class="flex flex-wrap gap-2"></div>
          </div>
          <input id="gallery-file" type="file" accept="image/*" multiple class="hidden" />
          <textarea name="images" id="gallery-paths" rows="3" class="input resize-none mt-2 text-xs text-gray-400" placeholder="Los paths aparecen aquí al subir..."></textarea>
        </div>

        <div class="grid grid-cols-2 gap-4">
          <div>
            <label class="label">URL demo</label>
            <input name="demoUrl" type="text" class="input" placeholder="https://..." />
          </div>
          <div>
            <label class="label">Texto botón demo</label>
            <input name="demoLabel" type="text" class="input" placeholder="Ver demo" />
          </div>
          <div>
            <label class="label">Thumbs count</label>
            <input name="thumbsCount" type="number" min="1" class="input" placeholder="3" />
          </div>
        </div>

        <div id="msg" class="hidden rounded-lg px-4 py-3 text-sm"></div>

        <button type="submit" class="w-full bg-indigo-600 hover:bg-indigo-500 text-white font-semibold rounded-lg py-2.5 transition-colors">
          Crear proyecto
        </button>
      </form>
    </main>

    <style>
      .label { display: block; font-size: 0.8rem; color: #9ca3af; margin-bottom: 0.25rem; }
      .input { width: 100%; background: #1f2937; color: white; border: 1px solid #374151; border-radius: 0.5rem; padding: 0.5rem 0.75rem; font-size: 0.875rem; outline: none; }
      .input:focus { border-color: #6366f1; }
      select.input option { background: #1f2937; }
      @keyframes spin { to { transform: rotate(360deg); } }
      .animate-spin { animation: spin 0.7s linear infinite; }
    </style>

    <script>
      function getSlug() {
        return document.getElementById("slug").value.replace(/[^a-zA-Z0-9\-_]/g, "");
      }

      async function uploadFile(file, slug) {
        const fd = new FormData();
        fd.append("file", file);
        fd.append("slug", slug || "general");
        const res = await fetch("/api/admin/upload", { method: "POST", body: fd });
        if (!res.ok) {
          const err = await res.json();
          throw new Error(err.error ?? "Error al subir");
        }
        return (await res.json()).path;
      }

      // Thumbnail
      document.getElementById("thumb-file").addEventListener("change", async (e) => {
        const file = e.target.files[0];
        if (!file) return;
        const slug = getSlug();
        if (!slug) { alert("Ingresá el slug primero"); return; }
        const spinner = document.getElementById("thumb-spinner");
        const preview = document.getElementById("thumb-preview");
        const placeholder = document.getElementById("thumb-placeholder");
        spinner.classList.remove("hidden");
        try {
          const path = await uploadFile(file, slug);
          document.getElementById("thumb-path").value = path;
          preview.src = path;
          preview.classList.remove("hidden");
          placeholder.classList.add("hidden");
        } catch (err) {
          alert(err.message);
        } finally {
          spinner.classList.add("hidden");
          e.target.value = "";
        }
      });

      // Gallery
      const galleryPaths = [];

      document.getElementById("gallery-file").addEventListener("change", async (e) => {
        const files = Array.from(e.target.files);
        if (!files.length) return;
        const slug = getSlug();
        if (!slug) { alert("Ingresá el slug primero"); return; }
        const placeholder = document.getElementById("gallery-placeholder");
        const thumbsEl = document.getElementById("gallery-thumbs");
        placeholder.classList.add("hidden");

        for (const file of files) {
          const wrapper = document.createElement("div");
          wrapper.className = "relative w-20 h-14 rounded-lg overflow-hidden bg-gray-800 flex items-center justify-center";
          wrapper.innerHTML = `<div class="w-4 h-4 border-2 border-indigo-400 border-t-transparent rounded-full animate-spin"></div>`;
          thumbsEl.appendChild(wrapper);

          try {
            const path = await uploadFile(file, slug);
            galleryPaths.push(path);
            document.getElementById("gallery-paths").value = galleryPaths.join("\n");
            wrapper.innerHTML = `<img src="${path}" class="w-full h-full object-cover" /><button type="button" onclick="removeGallery(this,'${path}')" class="absolute top-0.5 right-0.5 w-5 h-5 bg-black/70 text-white rounded-full text-xs flex items-center justify-center leading-none">×</button>`;
          } catch (err) {
            wrapper.innerHTML = `<span class="text-red-400 text-xs p-1">Error</span>`;
          }
        }
        e.target.value = "";
      });

      function removeGallery(btn, path) {
        btn.closest("div.relative").remove();
        const idx = galleryPaths.indexOf(path);
        if (idx !== -1) galleryPaths.splice(idx, 1);
        document.getElementById("gallery-paths").value = galleryPaths.join("\n");
        if (!galleryPaths.length) document.getElementById("gallery-placeholder").classList.remove("hidden");
      }

      // Submit
      document.getElementById("form").addEventListener("submit", async (e) => {
        e.preventDefault();
        const fd = new FormData(e.target);

        if (!fd.get("image")) {
          const err = document.getElementById("img-error");
          err.classList.remove("hidden");
          document.getElementById("thumb-drop").scrollIntoView({ behavior: "smooth", block: "center" });
          return;
        }
        document.getElementById("img-error").classList.add("hidden");

        const body = {
          slug: fd.get("slug"),
          title: fd.get("title"),
          image: fd.get("image") || undefined,
          url: fd.get("slug"),
          section: fd.get("section") || undefined,
          featured: fd.get("featured") ? Number(fd.get("featured")) : undefined,
          description: fd.get("description") ? fd.get("description").split("\n").filter(Boolean) : undefined,
          technologies: fd.get("technologies") ? fd.get("technologies").split(",").map(t => t.trim()).filter(Boolean) : undefined,
          images: fd.get("images") ? fd.get("images").split("\n").filter(Boolean) : undefined,
          demoUrl: fd.get("demoUrl") || undefined,
          demoLabel: fd.get("demoLabel") || undefined,
          thumbsCount: fd.get("thumbsCount") ? Number(fd.get("thumbsCount")) : undefined,
          specialPage: fd.get("specialPage") === "on" ? true : undefined,
        };

        const res = await fetch("/api/admin/proyectos", {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify(body),
        });

        const msg = document.getElementById("msg");
        msg.classList.remove("hidden");
        if (res.ok) {
          msg.className = "rounded-lg px-4 py-3 text-sm bg-green-500/10 border border-green-500/30 text-green-400";
          msg.textContent = "✓ Proyecto creado. Redirigiendo...";
          setTimeout(() => location.href = "/admin/dashboard", 1200);
        } else {
          const err = await res.json();
          msg.className = "rounded-lg px-4 py-3 text-sm bg-red-500/10 border border-red-500/30 text-red-400";
          msg.textContent = "Error: " + (err.error ?? "desconocido");
        }
      });
    </script>
  </body>
</html>
